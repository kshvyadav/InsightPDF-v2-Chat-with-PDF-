# InsightPDF Environment Configuration Template
# Copy this file to .env and replace placeholders with your actual keys/values.

# ------------------------------------------------------------------------------
# Server Settings
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000

# ------------------------------------------------------------------------------
# Ollama LLM Configuration
# ------------------------------------------------------------------------------
# Default local Ollama URL (use http://host.docker.internal:11434 if running in Docker on Windows/Mac)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ------------------------------------------------------------------------------
# Optional: External LLM & Embedding Providers (if switching models)
# ------------------------------------------------------------------------------
# GOOGLE_API_KEY=your_google_api_key_here
# HUGGINGFACEHUB_API_TOKEN=your_huggingface_token_here
# GROQ_API_KEY=your_groq_api_key_here

# ------------------------------------------------------------------------------
# Optional: LangSmith Observability & Tracing
# ------------------------------------------------------------------------------
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=your_langsmith_api_key_here
# LANGSMITH_PROJECT="InsightPDF"
